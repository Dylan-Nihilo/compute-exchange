omnisline.com, www.omnisline.com {
	handle /api/v1/auth/login {
		respond 404
	}

	handle /api/v1/* {
		reverse_proxy wanxiang-backend:8080
	}

	handle_path /cap/* {
		reverse_proxy cap:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Omnis API (万象网关, host port 13920) — reverse-proxied via the docker
# network gateway. Do not remove: token.omnisline.com is served by this
# same Caddy instance and must survive every frontend release.
token.omnisline.com {
	reverse_proxy 172.30.2.1:13920
}
